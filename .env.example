# Copy this file to .env and fill in your API key:
#   cp .env.example .env
#
# Get your key at: https://platform.openai.com/api-keys
# Required for: image validation (GPT-4o-mini) and LLM explanations in the dashboard.
# If omitted, the dashboard still works but uses static fallback explanations.

OPENAI_API_KEY=sk-proj-your-api-key-here
